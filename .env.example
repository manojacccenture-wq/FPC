# FPC frontend environment variables.
#
# Every VITE_* value is compiled into the browser bundle and is therefore PUBLIC.
# Never put credentials, tokens, keys or private URLs in a VITE_* variable.
#
# Files are selected by Vite mode:
#   npm run dev        -> .env.development
#   npm run build:dev  -> .env.development
#   npm run build:qa   -> .env.qa
#   npm run build:prod -> .env.production
#
# For Vercel Production Deployment:
#   Configure in Vercel Dashboard -> Settings -> Environment Variables:
#     VITE_APP_ENV=production
#     VITE_API_BASE_URL=/api/v1
#   Vercel edge rewrites in vercel.json will proxy /api/v1/* to https://fpc.runasp.net/api/v1/*
#
# Copy this file to `.env.local` (gitignored) to override values on one machine.

# Environment identity exposed as <html data-app-env>. One of: development | qa | production.
VITE_APP_ENV=development

# API base path used by every request. Keep relative so cookies stay first-party.
VITE_API_BASE_URL=/api/v1

# Dev server port (development only).
VITE_DEV_SERVER_PORT=5173

# Dev server proxy target for /api (development only).
VITE_API_PROXY_TARGET=http://localhost:5000

# Enables automatic address-based geocoding in onboarding Step 6.
# Leave false until GET /api/v1/geocoding/address is deployed on the backend.
# The geocoding provider key stays on the backend and is never a VITE_* value.
VITE_ENABLE_ADDRESS_GEOCODING=false

# Enables the IFSC -> bank/branch lookup in onboarding Step 3.
# Uses the public, keyless Razorpay IFSC endpoint directly from the browser, so no
# secret is involved; the lookup only pre-fills editable fields and never blocks
# manual entry. Enabled unless this is set to false.
VITE_ENABLE_IFSC_LOOKUP=true

# Demo-only: exposes the Validation ON/OFF toggle in the FPC registration wizard.
# Defaults to on for `npm run dev` and off in built artifacts.
# Toggling it OFF only stops the browser from blocking on client-side validation;
# the API still validates and rejects incomplete data. Set to true only for a
# build that will be used in a demo.
VITE_DEMO_VALIDATION_TOGGLE=false
